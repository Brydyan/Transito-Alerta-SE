# Dockerfile.minio — builds MinIO server from official GitHub release binaries.
#
# Background: minio/minio was removed from Docker Hub and quay.io/minio requires
# authentication even for public images (401 UNAUTHORIZED). This Dockerfile pulls
# the official pre-compiled binary directly from GitHub Releases, which are always
# publicly accessible.
#
# Usage (compose.yaml build section):
#   build:
#     context: .
#     dockerfile: docker/Dockerfile.minio
#
# Multi-arch: pass --build-arg TARGETARCH=arm64 for Apple Silicon / arm64 hosts.

FROM alpine:3.20

ARG MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
ARG TARGETARCH=amd64

RUN apk add --no-cache curl && \
    curl -fsSL \
      "https://github.com/minio/minio/releases/download/${MINIO_VERSION}/minio.linux-${TARGETARCH}.${MINIO_VERSION}" \
      -o /usr/local/bin/minio && \
    chmod +x /usr/local/bin/minio && \
    mkdir -p /data

EXPOSE 9000 9001

ENTRYPOINT ["/usr/local/bin/minio"]
