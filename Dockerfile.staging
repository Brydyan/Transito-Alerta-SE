# Dockerfile.staging — Backend + Frontend en un contenedor para Heroku staging
#
# Compila:
# 1. Backend NestJS (dist/backend)
# 2. Frontend Angular (dist/browser)
#
# Ejecuta:
# - Backend en $PORT (inyectado por Heroku)
# - Frontend en puerto 8080 (nginx)
# - Un script inicia ambos procesos

# ══════════════════════════════════════════════════════════════════════════════
# STAGE 1: Backend Dependencies + Build
# ══════════════════════════════════════════════════════════════════════════════
FROM node:22-alpine AS backend-deps
WORKDIR /app
RUN corepack enable
COPY backend/package.json backend/pnpm-lock.yaml backend/pnpm-workspace.yaml ./
RUN CI=true pnpm install --frozen-lockfile

FROM node:22-alpine AS backend-build
WORKDIR /app
RUN corepack enable
COPY backend/package.json backend/pnpm-lock.yaml backend/pnpm-workspace.yaml ./
COPY --from=backend-deps /app/node_modules ./node_modules
COPY backend/ ./
COPY database/seeds/lib /app/database/seeds/lib
RUN CI=true pnpm run build

# ══════════════════════════════════════════════════════════════════════════════
# STAGE 2: Frontend Build
# ══════════════════════════════════════════════════════════════════════════════
FROM node:22-alpine AS frontend-build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN CI=true pnpm install --frozen-lockfile
COPY . .
RUN CI=true pnpm run build --project=frontend

# ══════════════════════════════════════════════════════════════════════════════
# STAGE 3: Runtime — Backend + nginx
# ══════════════════════════════════════════════════════════════════════════════
FROM node:22-alpine

WORKDIR /app

# Instalar nginx + bash (sin supervisord)
RUN apk add --no-cache nginx bash curl

# ─────────────────────────────────────────────────────────────────────────────
# Backend setup
# ─────────────────────────────────────────────────────────────────────────────
COPY backend/package.json backend/pnpm-lock.yaml backend/pnpm-workspace.yaml ./
RUN corepack enable && \
    CI=true pnpm install --frozen-lockfile --prod

COPY --from=backend-build /app/dist ./dist

# ─────────────────────────────────────────────────────────────────────────────
# Frontend setup (nginx)
# ─────────────────────────────────────────────────────────────────────────────
COPY --from=frontend-build /app/dist/browser /usr/share/nginx/html

# nginx config: serve frontend + proxy /api to backend
RUN mkdir -p /etc/nginx/conf.d
COPY <<'EOF' /etc/nginx/nginx.conf
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    gzip on;

    server {
        listen 8080;
        server_name _;

        # Frontend: Angular SPA (fallback a index.html)
        location / {
            root /usr/share/nginx/html;
            index index.html index.htm;
            try_files $uri $uri/ /index.html;
        }

        # Backend API proxy (backend escucha en 3001 internamente)
        location /api {
            proxy_pass http://localhost:3001;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
EOF

# ─────────────────────────────────────────────────────────────────────────────
# Healthcheck
# ─────────────────────────────────────────────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8080 || exit 1

EXPOSE 8080

# Arranca backend + nginx en paralelo
# Backend escucha 3001, nginx proxy /api y sirve frontend en 8080
CMD ["sh", "-c", "node /app/dist/main.js & nginx -g 'daemon off;'"]
