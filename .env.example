# Transito Alerta SE — backend environment variables.
# Copy to `.env` (inside backend/, since CoreModule loads envFilePath: ['.env']
# relative to the backend working directory) and fill in real values.
# NEVER commit a `.env` file with real secrets.

# ---- App ----
APP_ENV=development
APP_PORT=3001

# ---- Database (Postgres / Supabase) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transito_alerta
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL=false
DB_POOL_MAX=20

# ---- Auth (dual JWT — design D2) ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Redis (cache DB 1, streams/sessions DB 0 — design "Scale Patterns") ----
# With a password: redis://:PASSWORD@host:6379
# Managed provider over TLS: rediss://:PASSWORD@host:6380
REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB=1
REDIS_STREAMS_DB=0

# Default TTL for cached responses, in seconds.
CACHE_TTL_SECONDS=60
# Geofencing lookups are cached on a ~110m grid (design D4).
GEOFENCING_CACHE_TTL_SECONDS=60

# ---- Rate limiting (CC1/T1.3) ----
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Observability ----
SENTRY_DSN=

# ---- SMTP (Mail module, R13) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@transito-alerta.example

# ---- AWS S3 (avatars / incident media) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---- Frontend ----
FRONTEND_BASE_URL=http://localhost:3000

# ---- Geofencing (D4) ----
# UUID of the default geo_zone (Santa Elena) — used when a lookup can't
# resolve a more specific containment match.
GEO_DEFAULT_ZONE_ID=
