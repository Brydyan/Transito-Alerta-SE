# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3004

# ─── Database (postgres container) ─────────────────────────────────────────────
DB_PORT=5437
POSTGRES_DB=transito_alerta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6381

# ─── Auth — CAMBIAR ESTOS (defaults inseguros) ─────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── Opcional ──────────────────────────────────────────────────────────────────
SENTRY_DSN=
PERMISSION_CACHE_TTL_SECONDS=300
SESSION_REFRESH_GRACE_SECONDS=30
CACHE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
GEOFENCING_CACHE_TTL_SECONDS=3600

# ─── Mail (omitir si no se usa el módulo Mail) ──────────────────────────────────
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@transito-alerta.example
# SMTP_PORT=587
# FRONTEND_BASE_URL=http://localhost:3000
# MAIL_SWEEP_INTERVAL_MS=5000
# MAIL_CLAIM_IDLE_MS=30000
