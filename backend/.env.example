# Transito Alerta SE — backend environment variables.
# Copy to `.env` (inside backend/, since CoreModule loads envFilePath: ['.env']
# relative to the backend working directory) and fill in real values.
# NEVER commit a `.env` file with real secrets.

# ---- App ----
APP_ENV=development
APP_PORT=3001

# ---- Database (Postgres / Supabase) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transito_alerta
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL=false
DB_POOL_MAX=20

# ---- Auth (dual JWT — design D2) ----
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Redis (cache DB 1, streams/sessions DB 0 — design "Scale Patterns") ----
# With a password: redis://:PASSWORD@host:6379
# Managed provider over TLS: rediss://:PASSWORD@host:6380
REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB=1
REDIS_STREAMS_DB=0

# Default TTL for cached responses, in seconds.
CACHE_TTL_SECONDS=60
# Geofencing lookups are cached on a ~110m grid (design D4).
GEOFENCING_CACHE_TTL_SECONDS=60

# ---- Rate limiting (CC1/T1.3) ----
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Observability ----
SENTRY_DSN=

# ---- SMTP (Mail module, R13) ----
# For development: use Mailhog (docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog)
# Or leave blank to skip email delivery in dev
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@transito-alerta.local
# XPENDING/XCLAIM sweep interval for the mail:outbox consumer (design D12).
MAIL_SWEEP_INTERVAL_MS=10000

# ---- Object Storage (comment images / avatars — SC-209 Phase A, D1) ----
# 'noop' (default): writes to a local .storage/ directory, no creds needed —
#   use this for local dev and the test suite.
# 'supabase': real Supabase Storage bucket — REQUIRED in production, must be
#   paired with STORAGE_SUPABASE_URL + STORAGE_SUPABASE_SERVICE_KEY below.
# 'minio': S3-compatible object store in Docker (infra/2026-10-07-minio-object-storage).
#   Use this for staging and local dev when you want a real HTTP-served
#   bucket without relying on the Supabase free-tier quotas.
STORAGE_PROVIDER=noop
# Required when STORAGE_PROVIDER=supabase. Your Supabase project URL.
STORAGE_SUPABASE_URL=
# Required when STORAGE_PROVIDER=supabase. Service-role key (NEVER the
# anon/public key — Storage writes need elevated privileges). Keep secret.
STORAGE_SUPABASE_SERVICE_KEY=
# Bucket name (must already exist in Supabase Storage, private). Default: uploads.
STORAGE_SUPABASE_BUCKET=uploads

# ---- MinIO / S3-compatible storage (infra/2026-10-07-minio-object-storage) ----
# Required when STORAGE_PROVIDER=minio. The internal Docker endpoint the
# backend uses to PUT/DELETE objects. The compose.yaml service is reachable
# at `http://minio:9000` from other containers on the same network.
STORAGE_MINIO_ENDPOINT=http://minio:9000
# Public-facing base URL the BROWSER uses. In dev with the nginx reverse
# proxy on http://localhost:8083, this is the /storage/ prefix on the
# frontend host. For staging behind a real domain, set to the public MinIO
# URL (e.g. https://cdn.example.com/uploads) so generated links work for
# end users. (design D5 — internal vs public split.)
STORAGE_MINIO_PUBLIC_URL=http://localhost:8083/storage
# Required when STORAGE_PROVIDER=minio. Must match MINIO_ROOT_USER below.
STORAGE_MINIO_ACCESS_KEY=minioadmin
# Required when STORAGE_PROVIDER=minio. Must match MINIO_ROOT_PASSWORD below.
STORAGE_MINIO_SECRET_KEY=minioadmin123
# Bucket name. Created by the minio-init container with a public-download
# policy. Default: uploads.
STORAGE_MINIO_BUCKET=uploads
# Path-style addressing is required for MinIO. Set to false ONLY for AWS S3
# itself, which prefers virtual-hosted style. Default: true.
STORAGE_MINIO_FORCE_PATH_STYLE=true

# ---- Frontend ----
FRONTEND_BASE_URL=http://localhost:3000

# ---- Telegram (F7 emergency-dispatch) ----
# Bot token from @BotFather (https://t.me/BotFather). NEVER commit. The
# `TelegramOutboxConsumer` (F7 D5/D8) reads it at send time; a missing
# token does NOT crash boot — the consumer logs a warn and the entry
# sits on `telegram:outbox` until the token is set.
# Leave blank in environments where Telegram is intentionally off (the
# repique scheduler will simply find no audience and noop).
TELEGRAM_BOT_TOKEN=
# Override the XPENDING/XCLAIM sweep interval. Production default
# mirrors `MAIL_SWEEP_INTERVAL_MS` (10s). The dev sandbox can leave
# this unset; staging owns tuning.
TELEGRAM_SWEEP_INTERVAL_MS=10000
TELEGRAM_CLAIM_IDLE_MS=30000
TELEGRAM_MAX_ATTEMPTS=3
# Override the reminder cadence. Production default 5 minutes (D10).
TELEGRAM_REMINDER_INTERVAL_MS=300000

# ---- Geofencing (D4) ----
# UUID of the default geo_zone (Santa Elena) — used when a lookup can't
# resolve a more specific containment match.
GEO_DEFAULT_ZONE_ID=
