# Dockerfile.migrations — Init container para validar + ejecutar migraciones
#
# Estapas:
#   dependencies — instala pnpm + deps (igual que el build principal)
#   migrations — copia scripts + datos + ejecuta validación
#
# Uso en docker-compose:
#   migrations:
#     ...
#     command: npx ts-node scripts/run-migrations.ts

FROM node:22-alpine AS dependencies
WORKDIR /app
RUN corepack enable
COPY backend/package.json backend/pnpm-lock.yaml backend/pnpm-workspace.yaml ./
RUN CI=true pnpm install --frozen-lockfile

FROM node:22-alpine AS migrations
WORKDIR /app/backend
RUN corepack enable
# Copia deps
COPY --from=dependencies /app/node_modules /app/backend/node_modules
# Copia scripts de migraciones (incluyendo lib/)
COPY backend/scripts/ /app/backend/scripts/
# Copia migrations desde la raíz
COPY database/migrations /app/database/migrations
# El comando se ejecuta desde docker-compose (ver compose.yaml)
CMD ["npx", "ts-node", "scripts/run-migrations.ts"]
