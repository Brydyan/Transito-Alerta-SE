# Contexto de build del frontend (compose.yaml → `context: ./frontend`).
#
# node_modules se reinstala dentro de la imagen desde el lockfile: copiarlo
# desde el host es más lento y arrastra binarios compilados para otra
# plataforma. dist/ se genera en el stage `build`, así que copiarlo sólo
# sirve para que un artefacto viejo del host tape al recién construido —
# exactamente el bug que este Dockerfile viene a cerrar.

node_modules/
dist/
.angular/
out-tsc/

# Artefactos y suites de test — no van a la imagen y engordan el contexto.
test-results/
playwright-report/
coverage/
e2e/
playwright.config.ts

# Arnés OpenSpec y documentación — no pertenecen al runtime ni al build web.
openspec/
docs/
*.md

# Scripts y temporales
*.js.map
migrate-scss-to-css.js

# El Dockerfile no se copia a sí mismo.
Dockerfile
.dockerignore

.git/
*.log
