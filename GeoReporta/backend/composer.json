{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "clickbar/laravel-magellan": "^2.2",
        "dedoc/scramble": "^0.13.28",
        "ext-swoole": "^5.0 || ^6.0",
        "intervention/image": "^4.2",
        "kreait/firebase-php": "^8.0",
        "laravel/framework": "^13.8",
        "laravel/octane": "*",
        "laravel/tinker": "^3.0",
        "lcobucci/jwt": "^5.6",
        "league/flysystem-aws-s3-v3": "^3.35",
        "matanyadaev/laravel-eloquent-spatial": "^4.8",
        "openspout/openspout": "^5.8",
        "paragonie/sodium_compat": "^2.5",
        "predis/predis": "^3.5",
        "spatie/laravel-prometheus": "*",
        "spiral/roadrunner-cli": "^2.7",
        "spiral/roadrunner-http": "^4.1",
        "staudenmeir/laravel-adjacency-list": "^1.26"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "*",
        "phpstan/phpstan": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "PHP_CLI_SERVER_WORKERS=4 php artisan serve"
        ],
        "lint": [
            "./vendor/bin/pint --test"
        ],
        "lint:fix": [
            "./vendor/bin/pint"
        ],
        "format": [
            "./vendor/bin/pint"
        ],
        "format:check": [
            "./vendor/bin/pint --test"
        ],
"test:unit": [
            "@php vendor/bin/pest --parallel --processes=4 --testsuite=Unit"
        ],
        "test:feature": [
            "@php vendor/bin/pest --parallel --processes=4 --testsuite=Feature"
        ],
        "test": [
            "@php vendor/bin/pest --parallel --processes=4"
        ],
        "test:coverage": [
            "@php artisan test --coverage"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
