# =============================================================
#  Sistema de Incidencias Georreferenciadas — .env.example
# =============================================================
#  Plantilla única. Copie este archivo a `.env` en la raíz y complete
#  los valores sin crear otro `.env` dentro de `backend/`.
#
#  El runtime Docker recibe estas variables mediante `env_file: .env`.
#  En Compose, `db`, `redis` y `rustfs` son nombres de servicio y solo
#  funcionan dentro de la red Docker; desde el host use `127.0.0.1` o
#  `localhost` junto con el puerto publicado. Un puerto `HOST:CONTAINER`
#  tiene dos ámbitos: el primero es del host y el segundo es interno.
#  En Swarm, `${VAR:-default}` se interpola desde el entorno del proceso
#  que ejecuta `docker stack deploy`; el archivo no sustituye esas variables.
#
#  Leyenda:
#    [DEV] desarrollo local; [STG] staging; [PROD] producción.
#    [REQ] obligatorio; [OPT] opcional; [SECRET] secreto; [COND] condicional.
#    Nunca comitee secretos: use el gestor de secretos del entorno o un
#    mecanismo equivalente fuera de Git.
#
#  Puerta mínima de producción:
#    APP_ENV=production, APP_DEBUG=false, APP_KEY único y JWT_ACCESS_SECRET /
#    JWT_REFRESH_SECRET aleatorios y distintos; URLs públicas HTTPS; cookies
#    seguras; CORS restringido; Redis autenticado; SMTP real; credenciales S3
#    reales; cuenta de servicio de Firebase montada si se usa Google; token de
#    Cloudflare externo; y credenciales de SonarQube fuera de este archivo.
#
#  Arquitectura: Laravel Octane/Swoole sirve API + SSE nativo; PostgreSQL /
#  PostGIS persiste datos; Redis sirve cache, sesiones, colas y Pub/Sub SSE;
#  RustFS/S3 almacena archivos; JWT es la autenticación local; Firebase es
#  opcional para Google; un worker procesa mail; Prometheus expone métricas;
#  SonarQube analiza código. No hay Mercure.
# =============================================================


# =============================================================
#  1. Núcleo de Laravel
# =============================================================
# Condición: [REQ] APP_KEY y el modo de entorno deben estar definidos antes
# de arrancar; los valores locales no son aptos para staging/producción.
# Laravel corre detrás de Nginx mediante Octane/Swoole. APP_URL es la URL
# base que usa Laravel para generar enlaces; FRONTEND_BASE_URL, más abajo,
# es la URL pública del frontend para invitaciones.

# [REQ] texto libre visible en la aplicación y en el nombre por defecto del mail.
# [DEV] cualquier nombre local; [STG/PROD] conservar un nombre estable.
APP_NAME="Sistema de Incidencias Georreferenciadas"
# [REQ] opciones: local | staging | production. [DEV] local.
# [STG/PROD] use staging/production según corresponda; producción exige
# APP_ENV=production y nunca debe reutilizar el entorno local.
APP_ENV=local                              # local | staging | production
# [REQ][SECRET] clave Laravel, normalmente `base64:<32 bytes>`; genere con
# `php artisan key:generate`. Debe ser única por entorno y nunca quedar vacía.
APP_KEY=                                    # 🔴 Generar con `php artisan key:generate`
# [REQ] booleano true|false. [DEV] true solo para depurar localmente;
# [STG/PROD] false para no exponer trazas, rutas ni configuración sensible.
APP_DEBUG=true                              # 🟡 false en prod
# [REQ] URL absoluta con esquema. [DEV] http://localhost:8000 (backend).
# [STG/PROD] URL pública HTTPS, sin depender de localhost; debe coincidir con
# la superficie que publica el frontend y con las reglas de CORS.
APP_URL=http://localhost:8000               # 🟡 URL base del backend (usada por config/filesystems.php para URLs de storage)
# [OPT] locale BCP-47/ISO usado por Laravel; el proyecto acepta los locales
# disponibles en sus traducciones. [DEV/STG/PROD] use el idioma operativo.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
# [OPT] locale válido para Faker, por ejemplo en_US o es_ES; solo impacta datos
# generados. [DEV] en_US; [STG/PROD] no debe confundirse con datos reales.
APP_FAKER_LOCALE=es
# [OPT] entero positivo: costo de bcrypt. [DEV] 12 es razonable; [STG/PROD]
# mida CPU/latencia antes de aumentarlo.
BCRYPT_ROUNDS=12                            # 🟢 factor de costo del hash de contraseñas

# [REQ] canal de logging configurado en backend/config/logging.php.
# Opciones principales: stack | stderr_json | single. [DEV] stack/single;
# [STG/PROD] stderr_json para agregadores Docker/Loki.
LOG_CHANNEL=stack                          # stack | stderr_json | single
# [COND] lista separada por comas de canales existentes; aplica cuando
# LOG_CHANNEL=stack. [DEV] single; [STG/PROD] stderr_json.
LOG_STACK=single
# [OPT] null o un canal de deprecaciones configurado.
LOG_DEPRECATIONS_CHANNEL=null
# [REQ] nivel: debug | info | warning | error (también niveles Monolog válidos).
# [DEV] debug; [STG/PROD] info o warning, nunca debug con datos públicos.
LOG_LEVEL=debug                             # debug | info | warning | error

# [REQ] driver de mantenimiento: file o cache. [DEV] file; [PROD]
# cache/database si se necesita coordinar varias réplicas.
APP_MAINTENANCE_DRIVER=file
# [COND][OPT] store requerido solo con driver cache; debe ser un store válido.
# Manténgalo comentado para el flujo local con file.
# APP_MAINTENANCE_STORE=database           # alterna si se requiere mantenimiento vía DB

# Sesiones: [REQ] driver válido file | cookie | database | memcached | redis |
# dynamodb | array. [DEV] cookie es simple; [STG/PROD] redis o un backend
# compartido. Si usa cookies, active SESSION_SECURE_COOKIE=true detrás de HTTPS.
SESSION_DRIVER=cookie
# [REQ] entero en minutos, >0; [DEV] 120. [STG/PROD] elegir según política.
SESSION_LIFETIME=120                        # minutos
# [OPT] booleano true|false; cifra datos de sesión cuando el driver lo permite.
# [PROD] combinar con APP_KEY único.
SESSION_ENCRYPT=false
# [OPT] ruta de cookie, normalmente `/`.
SESSION_PATH=/
# [OPT] dominio de cookie; null limita al host actual. En producción use el
# dominio correcto solo si frontend y API comparten el alcance necesario.
SESSION_DOMAIN=null
# [PROD] además de HTTPS, establezca SESSION_SECURE_COOKIE=true, conserve
# HTTP_ONLY=true y defina SameSite según el despliegue (lax por defecto).

# [OPT] BROADCAST_CONNECTION=log no habilita un hub: SSE nativo usa Redis Pub/Sub.
# [DEV] log es suficiente; no sustituya esta arquitectura por Mercure.
BROADCAST_CONNECTION=log
# [REQ] disco Laravel base (framework general-purpose, NO usado por
# imágenes): local | s3. [DEV] local. No confundir con FILESYSTEM_STORAGE_DISK
# abajo — esa confusión causó que el delete de imágenes de comentarios
# apuntara a un disco distinto del de subida, dejando objetos huérfanos en S3.
FILESYSTEM_DISK=local                       # local | s3
# [REQ] único disco leído por config('filesystems.image_disk') — usado por
# StorageService, subida/eliminación de imágenes de incidencias, comentarios
# y avatares, y el healthcheck de entrypoint.sh: s3 | public.
# [DEV] s3 con RustFS; [STG/PROD] s3 con endpoint/credenciales reales.
FILESYSTEM_STORAGE_DISK=s3                  # s3 | public — única fuente de verdad para imágenes
# [REQ] conexión de colas: redis | sync (entre las opciones usadas aquí).
# [DEV/STG/PROD] redis; el worker de mail consume esos Jobs. sync sirve para
# pruebas/debug local, pero no reemplaza el worker en un entorno real.
QUEUE_CONNECTION=redis
# [REQ] store de cache: redis | file | database (y otros soportados por Laravel).
# [DEV/STG/PROD] redis para compartir estado entre réplicas.
CACHE_STORE=redis                           # redis | file | database

# Octane/Swoole es el runtime HTTP del API y del stream SSE nativo.
# [REQ] OCTANE_SERVER=swoole; [DEV/STG/PROD] no cambiar sin validar SSE.
OCTANE_SERVER=swoole                       # swoole (valor estándar del proyecto desde ADR-0007)
# [OPT] booleano true|false. [DEV] false; [STG/PROD] true solo si TLS termina
# en el propio Octane. Si TLS termina en Nginx/Cloudflare, coordine proxies y
# cookies HTTPS; la URL pública igualmente debe ser HTTPS.
OCTANE_HTTPS=false                          # 🟢 forzar HTTPS en Octane (false en dev)
# [OPT] enteros positivos. Déjelos omitidos para que Octane calcule según CPU;
# un valor vacío NO equivale a omitido y se convierte en 0. Solo descomente al
# tunear explícitamente y valide memoria/conexiones SSE en el entorno objetivo.
# OCTANE_WORKER_NUM=                         # 🟢 opcional; omitido → Octane calcula según CPU
# OCTANE_TASK_WORKER_NUM=                    # 🟢 opcional; omitido → Octane calcula según CPU
# [REQ] versión semántica o cadena compatible con la API; [DEV/STG/PROD]
# mantenerla alineada con el contrato publicado.
API_VERSION=1.0.0


# =============================================================
#  2. Base de datos (PostgreSQL + PostGIS)
# =============================================================
# Condición: el backend y los exportadores deben resolver `db` dentro de
# Docker/Swarm y PostgreSQL debe tener PostGIS disponible. Fuera de Docker,
# use 127.0.0.1 y el puerto publicado.
#
# DB_PORT controla solo HOST:CONTAINER del servicio `db` (`5432` interno).
# Dentro de la red Docker el backend siempre usa `db:5432`; no cambie ese
# puerto interno por el puerto publicado. Rango de host aceptado: 5432–5435
# (5432 = principal; 5433–5435 reservados para stacks paralelos).

# [REQ] driver: pgsql.
DB_CONNECTION=pgsql
# [REQ] hostname o IP. [DEV/STG/PROD en Docker] db; [DEV fuera de Docker]
# 127.0.0.1. No use localhost desde otro contenedor.
DB_HOST=db                                  # 'db' (compose hostname) o 127.0.0.1 fuera de docker
# [REQ] entero 5432–5435 para el puerto publicado del host; dentro de Docker
# el servicio continúa escuchando en 5432.
DB_PORT=5432                                # 5432–5435 (puerto del host); default 5432
# [REQ] identificadores de base; sin espacios no escapados.
DB_DATABASE=incidencias_db
# [REQ] usuario PostgreSQL. `user`/`password` son solo desarrollo;
# en staging/producción use una cuenta dedicada con privilegios mínimos.
DB_USERNAME=user                            # cambiar en producción
# [REQ][SECRET] contraseña no vacía, única y almacenada fuera de Git.
# `password` es insegura y solo sirve para desarrollo local.
DB_PASSWORD=password                        # 🔴 cambiar en prod


# =============================================================
#  3. Redis (cache, sesiones, colas y Pub/Sub SSE)
# =============================================================
# Condición: Redis es infraestructura compartida para cache, sesiones, queue
# worker y distribución de eventos SSE. En Docker use `redis`; desde el host
# use 127.0.0.1 y el puerto publicado. En Swarm Redis no publica puerto al host.
# Producción exige autenticación (`requirepass`) y una contraseña única; no
# deje Redis accesible sin auth ni exponga 6379 innecesariamente.

# [REQ] cliente instalado: phpredis | predis. [DEV/STG/PROD] phpredis.
REDIS_CLIENT=phpredis                       # phpredis | predis
# [REQ] hostname del servicio o IP. [DEV/STG/PROD Docker] redis;
# [DEV fuera de Docker] 127.0.0.1.
REDIS_HOST=redis                            # 'redis' o 127.0.0.1
# [REQ] entero; 6379 es el puerto interno y el default publicado local.
REDIS_PORT=6379
# [COND][SECRET] `null` permite desarrollo con la configuración local actual;
# [STG/PROD] contraseña no vacía, única, igual a la usada por Redis
# `--requirepass`, y guardada fuera de Git.
REDIS_PASSWORD=null                         # habilitar con una contraseña única en staging/producción

# [OPT] entero positivo en segundos para `feed:v2:*`; vacío, no numérico,
# cero o negativo usa 604800 (7 días). [DEV] vacío; [STG/PROD] ajuste según
# memoria y frescura requerida, sin deshabilitar la expiración por accidente.
# REDIS_FEED_TTL_SECONDS: TTL (segundos) de las claves feed:v2:* en Redis
# (feed:v2:items, feed:v2:index) tras cada rebuild o sync. Tiene que ser
# entero positivo. Valores vacíos, no numéricos, cero o negativos caen al
# valor predeterminado documentado (604800 = 7 días) para evitar que Redis::expire
# borre las claves silenciosamente.
REDIS_FEED_TTL_SECONDS=


# =============================================================
#  4. Almacenamiento (compatible con S3; RustFS en DEV)
# =============================================================
# Condición: si FILESYSTEM_STORAGE_DISK=s3, el endpoint, bucket y ambas
# credenciales deben ser alcanzables y válidos desde el contenedor backend.
# Dentro de Docker el endpoint local es `http://rustfs:9000`; desde el host
# use `http://localhost:${RUSTFS_API_PORT}`. Para AWS S3 u otro proveedor,
# use su endpoint HTTPS y credenciales reales. `AWS_*` es la fuente que lee
# Laravel; `STORAGE_*` solo inicializa el servidor RustFS.

# [REQ][SECRET] credencial S3/RustFS. `rustfsadmin` solo es desarrollo y debe
# cambiarse antes de cualquier staging/producción. No reutilice claves entre
# entornos y almacénelas fuera de Git.
AWS_ACCESS_KEY_ID=rustfsadmin              # 🔴 cambiar en prod
AWS_SECRET_ACCESS_KEY=rustfsadmin           # 🔴 cambiar en prod
# [REQ] región S3 válida; RustFS local acepta us-east-1.
AWS_DEFAULT_REGION=us-east-1
# [REQ] nombre de bucket existente o que el operador pueda crear.
AWS_BUCKET=incidencias
# [REQ] URL absoluta. [DEV] http://rustfs:9000 dentro de Docker;
# [STG/PROD] endpoint HTTPS de S3/RustFS, con DNS y TLS válidos.
AWS_ENDPOINT=http://rustfs:9000             # 🟡 URL del endpoint S3
# [REQ] booleano true|false. true para RustFS/MinIO; false normalmente para
# AWS S3. Debe coincidir con el proveedor real.
AWS_USE_PATH_STYLE_ENDPOINT=true

# [COND][SECRET] credenciales con las que ARRANCA el servicio RustFS; deben
# coincidir con AWS_* en DEV. Con AWS S3 real, STORAGE_* no se usa para el
# backend y puede quedar vacío, pero deploy.yml las exige si levanta RustFS.
# En PROD, si se mantiene RustFS, use credenciales únicas y endpoint HTTPS.
STORAGE_ACCESS_KEY=rustfsadmin              # 🔴 cambiar en prod (credenciales del server RustFS)
STORAGE_SECRET_KEY=rustfsadmin              # 🔴 cambiar en prod


# =============================================================
#  5. JWT (autenticación local del backend)
# =============================================================
# Condición: ambos secretos son obligatorios para login/refresh. Genere cada
# uno con `openssl rand -base64 48` (mínimo 32 bytes), use valores aleatorios
# distintos por entorno y no los copie desde otro entorno. Rotar el secreto de
# acceso no invalida los tokens de renovación; planifique rotación de ambos.

# [REQ][SECRET] mínimo 32 bytes aleatorios; nunca un nombre, contraseña o
# valor de ejemplo. Mantener fuera de Git y distinto del secreto de renovación.
JWT_ACCESS_SECRET=                         # 32+ bytes aleatorios
# [REQ][SECRET] mínimo 32 bytes aleatorios; DISTINTO del secreto de acceso.
JWT_REFRESH_SECRET=                         # 32+ bytes aleatorios
# [REQ] duración compatible con el analizador JWT, por ejemplo 15m, 1h, 7d.
# [DEV] 15m/7d; [STG/PROD] defina una política de expiración y rotación.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# =============================================================
#  6. SSE nativo (notificaciones en tiempo real)
# =============================================================
# Condición: el stream GET /api/notifications/stream lo sirve directamente
# Octane/Swoole; Redis Pub/Sub distribuye eventos entre réplicas y JWT autoriza
# mediante cookie o encabezado Authorization. No hay hub externo ni secretos de
# publicación/suscripción. El proxy debe soportar conexiones largas, HTTPS en
# staging/producción y timeouts compatibles con el heartbeat.
# Estos valores son [OPT] y se leen desde backend/config/notifications.php.
# No crear backend/.env ni reintroducir Mercure.

# [OPT] entero positivo: máximo de notificaciones del snapshot inicial al
# reconectar con Last-Event-ID. [DEV] 50; [STG/PROD] ajuste por ancho de banda.
NOTIFICATIONS_STREAM_SNAPSHOT_CAP=50            # 🟢 máximo de notificaciones en snapshot inicial (Last-Event-ID)
# [OPT] entero en segundos, recomendado 10–60. También revalida la sesión;
# valores altos dejan conexiones muertas más tiempo.
NOTIFICATIONS_STREAM_HEARTBEAT_SECONDS=30       # 🟢 intervalo del keepalive SSE; también revalida la sesión
# [OPT] texto sin espacios separadores; forma `prefijo:{id}:sufijo`.
NOTIFICATIONS_STREAM_CHANNEL_PREFIX=user        # 🟢 prefijo del canal Redis (→ "user:{id}:notifications")
# [OPT] texto sin espacios separadores; debe producir canales consistentes
# entre todas las réplicas.
NOTIFICATIONS_STREAM_CHANNEL_SUFFIX=notifications # 🟢 sufijo del canal Redis


# =============================================================
#  7. Firebase Admin SDK (login con Google)
# =============================================================
# Condición: [COND][OPT] solo es necesario si se habilita el registro/login
# con Google. El frontend y el backend deben pertenecer al mismo proyecto.
# El JSON es una cuenta de servicio secreta: no lo comitee ni lo exponga.
# En Docker, FIREBASE_CREDENTIALS debe ser una ruta absoluta DENTRO del
# contenedor (por ejemplo /var/www/backend/storage/...), y ese archivo debe
# estar montado desde un gestor de secretos o volumen seguro. Una ruta del
# host no sirve por sí sola dentro del contenedor.

# [COND][SECRET] ruta absoluta al JSON montado; el marcador no funciona.
FIREBASE_CREDENTIALS=/var/www/backend/storage/auth-XXXXXX-firebase-adminsdk-fbsvc-YYYYYY.json  # ruta al JSON de cuenta de servicio
# [COND][REQ si Firebase] ID exacto del proyecto Firebase/GCP, sin secretos.
FIREBASE_PROJECT_ID=auth-XXXXXX                                                       # ID del proyecto
# [OPT] entero no negativo en segundos para tolerancia de desfase horario;
# 5 es el valor de referencia. Manténgalo bajo y sincronice relojes en PROD.
FIREBASE_LEEWAY_SECONDS=5                                                             # tolerancia de desfase horario


# =============================================================
#  8. Mail (worker de colas y SMTP)
# =============================================================
# Condición: en DEV `log` registra los mensajes sin enviarlos; en STG/PROD
# debe usar SMTP real (o un proveedor soportado), credenciales válidas y TLS.
# QUEUE_CONNECTION=redis requiere el servicio worker para procesar mails de
# asignación e invitación. Verifique DNS, puerto, autenticación, dominio
# remitente verificado y que el proveedor permita el envío antes de producción.

# [REQ] opción soportada: smtp | sendmail | mailgun | ses | ses-v2 | postmark |
# resend | log | array | failover | roundrobin. [DEV] log (seguro, no entrega);
# [STG/PROD] smtp o proveedor real, nunca log si se espera entrega.
MAIL_MAILER=log
# [COND] host SMTP o proveedor. [DEV] 127.0.0.1 solo con un receptor local;
# [STG/PROD] hostname real del proveedor, por ejemplo smtp.gmail.com.
MAIL_HOST=127.0.0.1
# [COND] entero TCP; 2525 para un receptor de correo local; 587 STARTTLS o 465 TLS
# según el proveedor. No exponga credenciales en la URL.
MAIL_PORT=2525
# [COND][SECRET] usuario SMTP; null/empty solo es válido para log o un receptor
# sin autenticación. [STG/PROD] cuenta dedicada y credencial fuera de Git.
MAIL_USERNAME=null
MAIL_PASSWORD=null
# [REQ] dirección RFC 5322 válida. [DEV] hello@example.com es un marcador;
# [STG/PROD] dominio remitente verificado por el proveedor.
MAIL_FROM_ADDRESS="hello@example.com"
# [OPT] nombre visible; `${APP_NAME}` usa el nombre de la aplicación.
MAIL_FROM_NAME="${APP_NAME}"
# [PROD] configure `MAIL_SCHEME=tls` (o el esquema exigido por el proveedor),
# use HTTPS/TLS y valide certificados. No confunda MAIL_FROM_* con credenciales.

# ──────────────────────────────────────────────────────────────────────
#  Gmail / SMTP — remitente de notificaciones de asignación
# ──────────────────────────────────────────────────────────────────────
# [OPT] sobrescribe solo el remitente de mails de asignación. Si está vacío,
# SmtpMailSender hace fallback a MAIL_FROM_ADDRESS / MAIL_FROM_NAME.
# Las credenciales SMTP (host, port, username, password, scheme) se mantienen
# en MAIL_*; no duplique secretos en GMAIL_*.
GMAIL_FROM_ADDRESS="${MAIL_FROM_ADDRESS}"
GMAIL_FROM_NAME="${MAIL_FROM_NAME}"

# ──────────────────────────────────────────────────────────────────────
#  Invitaciones de usuario
# ──────────────────────────────────────────────────────────────────────
# Condición: el enlace se construye con FRONTEND_BASE_URL y necesita una URL
# pública alcanzable por el destinatario. [DEV] puede quedar vacío para usar
# APP_URL; [STG/PROD] defina la URL HTTPS pública exacta, sin localhost y sin
# exponer tokens en logs. TERMS_VERSION debe corresponder al documento vigente.
#
# [OPT] entero positivo en horas; valor funcional predeterminado 48. Valide la política
# antes de acortarlo o extenderlo.
INVITATION_TTL_HOURS=48              # 🟢 vigencia de invitación en horas
# [REQ para publicar términos] texto de versión, por ejemplo v1, v2; v0 es
# un marcador de desarrollo y no acredita una versión legal real.
TERMS_VERSION=v0                     # 🟢 versión de Términos y Condiciones aceptada
# [OPT] URL absoluta del frontend. Vacía usa APP_URL como fallback.
FRONTEND_BASE_URL=                    # 🟢 vacío → usa APP_URL como fallback


# =============================================================
#  9. CORS
# =============================================================
# Condición: lista separada por comas de orígenes exactos (esquema + host +
# puerto, sin rutas). `supports_credentials=true`, por lo que no use `*`.
# [DEV] http://localhost:3000; [STG/PROD] solo URLs HTTPS públicas conocidas
# del frontend. Debe coincidir con APP_URL/FRONTEND_BASE_URL y con el dominio
# real que envía cookies/JWT; restringirlo evita solicitudes cross-site no
# autorizadas.
CORS_ALLOWED_ORIGINS=http://localhost:3000


# =============================================================
#  10. Compose: puertos, imágenes y observabilidad
# =============================================================
# Condición: estas variables son de interpolación Docker Compose/Swarm, no
# configuración Laravel directa. En `HOST:CONTAINER`, el puerto izquierdo es
# del host y el derecho es interno. Los servicios se llaman `db`, `redis`,
# `rustfs`, `backend`, etc. dentro de la red; `localhost` desde un contenedor
# apunta a ese mismo contenedor, no al host ni a otro servicio.
#
# En Compose local, los valores predeterminados `:-` son útiles para DEV. En
# Swarm, la interpolación usa el entorno del proceso que ejecuta
# `docker stack deploy`; exporte/proporcione allí cada secreto y no dependa de
# que Swarm lea este archivo automáticamente. Producción debe publicar solo lo
# necesario detrás de TLS/HTTPS y restringir interfaces/firewall.

# Puertos publicados en el HOST; los puertos internos de los contenedores son
# frontend 80, backend 8000, Prometheus 9090, Grafana 3000, Loki 3100,
# RustFS API 9000/consola 9001 y SonarQube 9000.
# [DEV] valores predeterminados; [STG/PROD] elija puertos libres y publique
# solo servicios protegidos por proxy/firewall. DB_PORT y REDIS_PORT no cambian
# los puertos internos que usan `db:5432` y `redis:6379` dentro de Docker.
FRONTEND_PORT=3000
BACKEND_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# [OPT] puerto HOST del UI/API de SonarQube; el servicio escucha internamente
# en 9000. [DEV] 9002; [PROD] publicar mediante acceso administrativo seguro.
SONARQUBE_PORT=9002

# Imágenes Docker. [DEV] RUSTFS_IMAGE=rustfs/rustfs:latest es cómodo pero no
# reproducible; [STG/PROD] use tags/digests fijados y actualizaciones explícitas.
# POSTGIS_IMAGE y SONARQUBE_* ya usan versiones explícitas; verifique también
# imágenes externas antes de promoverlas.
POSTGIS_IMAGE=postgis/postgis:17-3.5-alpine
REDIS_IMAGE=redis:8-alpine
RUSTFS_IMAGE=rustfs/rustfs:latest
SONARQUBE_IMAGE=sonarqube:26.7.0.124771-community
SONARQUBE_DB_IMAGE=postgres:17-alpine

# SonarQube es un stack independiente de Prometheus/Grafana/Loki, con su
# propio Postgres `sonarqube_db`. [OPT][COND] solo necesario para análisis.
# Antes de arrancar, el host necesita vm.max_map_count >= 262144. Los valores
# admin/default de desarrollo no son aptos para producción: cambie credenciales
# y proteja el UI. SONAR_TOKEN y SONAR_HOST_URL de CI son secretos del repositorio
# GitHub, no variables de este archivo.
SONARQUBE_DB_DATABASE=sonarqube           # DB interna del stack SonarQube
# [REQ] usuario dedicado; cambiar el valor predeterminado de desarrollo en PROD.
SONARQUBE_DB_USERNAME=sonarqube
# [REQ][SECRET] contraseña no vacía, única; genere con `openssl rand -base64 24`
# y guárdela fuera de Git. El valor vacío es solo un marcador local.
SONARQUBE_DB_PASSWORD=                    # 🔴 Generar con `openssl rand -base64 24`
# [REQ] puerto INTERNO de `sonarqube_db`; no es SONARQUBE_PORT ni se publica.
SONARQUBE_DB_PORT=5432                    # puerto INTERNO del contenedor sonarqube_db

# CI (GitHub Actions): SONAR_TOKEN y SONAR_HOST_URL son secretos del repositorio
# y NO van acá. Ver ops/sonarqube/README.md → "Exposing SonarQube for CI" para
# el setup con Cloudflare Tunnel. El runner necesita una URL pública HTTPS;
# localhost solo funciona en la máquina de desarrollo.

# [COND][SECRET] token de Cloudflare Tunnel. [DEV] solo si se prueba el túnel;
# [STG/PROD] token externo, único y almacenado en el gestor de secretos; no
# reutilice el token de desarrollo. El túnel debe publicar URLs HTTPS y tener
# rutas configuradas a los nombres de servicio, no a localhost.
CLOUDFLARE_TUNNEL_TOKEN=                    # 🔴 token del túnel (no dejar el de dev en prod)


# =============================================================
#  11. Ajustes de aplicación (Prometheus y límite de feed)
# =============================================================
# Condición: son ajustes de runtime; no cambian la topología Docker ni
# requieren reconstruir la imagen. Valide impacto de memoria y carga antes de
# cambiar valores en producción.

# [OPT] store Laravel usado por el exporter de Prometheus para persistir
# counters/gauges/histograms/summaries. Opciones: redis | array | file |
# memcached (y stores soportados por Laravel). [DEV/STG/PROD] redis para
# compartir estado; [CI/tests] array evita contaminar Redis.
PROMETHEUS_CACHE=redis                       # 🟢 redis | array | file | memcached

# [OPT] entero positivo de requests/min para usuarios autenticados en
# GET /api/incidents/feed; SuperAdmin queda exento y anónimos usan el valor
# predeterminado interno de 60/min. [DEV] 120; [STG/PROD] dimensionar según
# capacidad y protección antiabuso.
FRONTEND_URL=http://localhost:5173             # 🌐 URL del frontend SPA (usada en mails de recuperación)
FEED_RATE_LIMIT_PER_MIN=120                  # 🟢 requests/min para usuarios autenticados
