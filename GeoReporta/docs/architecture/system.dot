/**
 * System architecture — Sistema de Incidencias Georreferenciadas
 *
 * Source of truth for the architecture diagram shipped in README.md.
 * Render to SVG with:
 *   dot -Tsvg docs/architecture/system.dot -o docs/architecture/system.svg
 * Or run: ./docs/architecture/build.sh  (requires graphviz installed)
 *
 * Conventions:
 *   solid  = real request traffic
 *   dashed = observability / CI (no user traffic)
 *   cylinder  = datastore
 *   octagon   = hub / pub-sub
 *   note      = external / managed outside the repo
 *   ⚠         = caveat known for the current state
 */

digraph architecture {
    // ------------------------------------------------------------------
    //  Layout
    // ------------------------------------------------------------------
    rankdir=TB;
    splines=polyline;
    nodesep=0.55;
    ranksep=0.9;
    bgcolor="white";
    compound=true;
    newrank=true;
    pad=0.4;
    concentrate=false;
    fontname="Helvetica";
    fontsize=12;

    // Default node / edge
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.14,0.09", color="#37474F"];
    edge [fontname="Helvetica", fontsize=9, color="#546E7A", arrowsize=0.85, penwidth=1.0];

    // ------------------------------------------------------------------
    //  Client + edge
    // ------------------------------------------------------------------
    Browser [label="Browser\nVanilla JS · Vite 6\nSSE (EventSource)",
             fillcolor="#FFF3E0", color="#E65100", fontcolor="#BF360C"];

    CF [label="Cloudflare Tunnel\nTLS termination\n(managed outside repo)",
        shape=note, fillcolor="#F3E5F5", color="#6A1B9A", fontcolor="#4A148C"];

    // ------------------------------------------------------------------
    //  Frontend container
    // ------------------------------------------------------------------
    subgraph cluster_fe {
        label="Frontend container · nginx:alpine";
        labeljust=l;
        style=filled;
        fillcolor="#E0F7FA";
        color="#00838F";
        fontcolor="#006064";
        fontname="Helvetica-Bold";
        penwidth=1.5;

        Nginx [label="Nginx :80\nstatic + reverse proxy\nproxy_buffering off",
               fillcolor="#B2DFDB", color="#00695C", fontcolor="#004D40"];
        SPA [label="SPA estática\nBootstrap 5 · Leaflet\nTurf · Tom Select",
             shape=note, fillcolor="#FFFFFF", color="#00695C", fontcolor="#004D40"];
    }

    // ------------------------------------------------------------------
    //  Backend container
    // ------------------------------------------------------------------
    subgraph cluster_be {
        label="Backend container · PHP 8.3 + Swoole 5 · octane:start + schedule:work";
        labeljust=l;
        style=filled;
        fillcolor="#E8EAF6";
        color="#3949AB";
        fontcolor="#1A237E";
        fontname="Helvetica-Bold";
        penwidth=1.5;

        Octane [label="Laravel 13.15\nOctane 2.17.5 · driver=swoole\nQUEUE_CONNECTION=redis",
                fillcolor="#C5CAE9", color="#283593", fontcolor="#1A237E"];

        Worker [label="Queue worker\nphp artisan queue:work redis\n(mail: SendAssignment, SendInvitation)",
                shape=note, fillcolor="#FFFFFF", color="#283593", fontcolor="#1A237E"];
    }

    // ------------------------------------------------------------------
    //  Pub/Sub broker (was Mercure, now Redis)
    // ------------------------------------------------------------------
    PubSub [label="Redis Pub/Sub\nchannel: user:{id}:notifications\nlive delivery to SSE stream",
            shape=octagon, fillcolor="#FFF8E1", color="#FF8F00", fontcolor="#E65100"];

    // ------------------------------------------------------------------
    //  Data tier
    // ------------------------------------------------------------------
    subgraph cluster_data {
        label="Data tier";
        labeljust=l;
        style=filled;
        fillcolor="#ECEFF1";
        color="#546E7A";
        fontcolor="#263238";
        fontname="Helvetica-Bold";
        penwidth=1.5;

        PG [label="PostgreSQL 17\n+ PostGIS 3.5",
            shape=cylinder, fillcolor="#CFD8DC", color="#37474F", fontcolor="#263238"];
        Redis [label="Redis 8\nCQRS read model · cache\nPub/Sub broker for SSE",
               shape=cylinder, fillcolor="#CFD8DC", color="#37474F", fontcolor="#263238"];
        RustFS [label="RustFS\nS3-compatible\nself-hosted",
                shape=cylinder, fillcolor="#CFD8DC", color="#37474F", fontcolor="#263238"];
    }

    // ------------------------------------------------------------------
    //  Observability
    // ------------------------------------------------------------------
    subgraph cluster_obs {
        label="Observability (sin tracing · sin APM)";
        labeljust=l;
        style=filled;
        fillcolor="#FCE4EC";
        color="#AD1457";
        fontcolor="#880E4F";
        fontname="Helvetica-Bold";
        penwidth=1.5;

        Prom [label="Prometheus\n⚠ sin volumen",
               fillcolor="#F8BBD0", color="#AD1457", fontcolor="#880E4F"];
        Loki [label="Loki + Promtail\n⚠ sin volumen",
               fillcolor="#F8BBD0", color="#AD1457", fontcolor="#880E4F"];
        Graf [label="Grafana\ndashboards",
               fillcolor="#F8BBD0", color="#AD1457", fontcolor="#880E4F"];
    }

    // ------------------------------------------------------------------
    //  Quality + CI
    // ------------------------------------------------------------------
    subgraph cluster_ci {
        label="Calidad + CI";
        labeljust=l;
        style=filled;
        fillcolor="#E8F5E9";
        color="#2E7D32";
        fontcolor="#1B5E20";
        fontname="Helvetica-Bold";
        penwidth=1.5;

        GH [label="GitHub Actions\nPint · Pest\nESLint · Prettier · Vitest",
            fillcolor="#C8E6C9", color="#2E7D32", fontcolor="#1B5E20"];
        Sonar [label="SonarQube\nCommunity\n⚠ Clover PHP no generado",
               fillcolor="#C8E6C9", color="#2E7D32", fontcolor="#1B5E20"];
    }

    // ------------------------------------------------------------------
    //  Request flow (solid)
    // ------------------------------------------------------------------
    Browser  -> CF      [label="HTTPS"];
    CF       -> Nginx   [label="HTTP :80\n+X-Forwarded-Proto"];
    Nginx    -> SPA     [label="sirve /dist"];
    Nginx    -> Octane  [label="/api/* · /storage/*\n/.well-known → /api/notifications/stream"];

    Octane   -> PG      [label="spatial queries"];
    Octane   -> Redis   [label="CQRS sync listeners\n+ Pub/Sub subscribe"];
    Octane   -> RustFS  [label="upload imágenes"];

    // Live notification path: backend writes to Redis Pub/Sub on the
    // user's channel, the same Redis broker fans out to subscribed
    // SSE endpoints (one per logged-in user), which the browser keeps
    // alive via EventSource's automatic reconnect.
    Octane   -> PubSub  [label="publish\n(user:{id}:notifications)", color="#FB8C00", fontcolor="#E65100"];
    PubSub   -> Octane  [label="subscribe\n(per request)", color="#1565C0", fontcolor="#1565C0"];
    Octane   -> Browser [label="SSE stream\nEventSource",
                         color="#1565C0", fontcolor="#1565C0", penwidth=1.6];

    // Queue worker (mail jobs) runs in its own container in prod; in
    // compose dev it's still separate. The publish queue is the same
    // Redis used for Pub/Sub.
    Octane   -> Redis   [label="dispatch mail jobs", style=dashed, color="#888888"];
    Worker   -> Redis   [label="consume mail jobs", style=dashed, color="#888888"];

    // ------------------------------------------------------------------
    //  Observability (dashed gray)
    // ------------------------------------------------------------------
    Octane -> Prom [label="/metrics", style=dashed, color="#888888", fontcolor="#555555"];
    Nginx  -> Prom [label="/nginx_status", style=dashed, color="#888888", fontcolor="#555555"];
    PG     -> Prom [label="pg_exporter", style=dashed, color="#888888", fontcolor="#555555"];
    Redis  -> Prom [label="redis_exporter", style=dashed, color="#888888", fontcolor="#555555"];
    Octane -> Loki [label="stderr", style=dashed, color="#888888", fontcolor="#555555"];
    Nginx  -> Loki [label="access logs", style=dashed, color="#888888", fontcolor="#555555"];
    Prom   -> Graf [style=dashed, color="#888888"];
    Loki   -> Graf [style=dashed, color="#888888"];

    // ------------------------------------------------------------------
    //  CI (dashed green)
    // ------------------------------------------------------------------
    GH    -> Octane [label="lint + test + build", style=dashed, color="#2E7D32", fontcolor="#1B5E20"];
    GH    -> Nginx  [label="lint + test + build", style=dashed, color="#2E7D32", fontcolor="#1B5E20"];
    GH    -> Sonar  [label="scan condicional\n(si SONAR_TOKEN)",
                     style=dashed, color="#2E7D32", fontcolor="#1B5E20"];

    // ------------------------------------------------------------------
    //  Rank alignment (keeps flows visually tight)
    // ------------------------------------------------------------------
    { rank=same; Browser; CF; }
    { rank=same; Nginx; SPA; }
    { rank=same; Octane; PubSub; Worker; }
    { rank=same; PG; Redis; RustFS; }
    { rank=same; Prom; Loki; Graf; }
    { rank=same; GH; Sonar; }
}
