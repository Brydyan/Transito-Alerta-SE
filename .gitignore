# Environment variables — NEVER commit .env with secrets
.env
.env.local
.env.*.local
.env.production.local

# Dependencies
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock

# Build outputs
dist/
build/
*.tsbuildinfo
out/

# IDE & Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
.history/
.env.local.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/
jest-coverage/
*.lcov
.testcache/

# Temporary & cache files
tmp/
temp/
cache/
.cache/
.eslintcache
.prettier-ignore

# OS artifacts
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride
._*

# Docker (if using local containers)
.docker/
docker-compose.override.yml

# Database (local dev only)
*.db
*.sqlite
*.sqlite3
data/
# ...pero `database/data/` son insumos cartográficos versionados (GeoJSON de
# origen + su NOTICE de licencias), no datos locales de un contenedor.
!database/data/

# Object storage (local dev) — NoopStorageClient (SC-209 D1) writes here
.s3/
uploads/
media/
.storage/

# Secrets & credentials
*.pem
*.key
*.crt
.aws/
.ssh/

# Compiled TypeScript (if not in dist/)
src/**/*.js
src/**/*.js.map
test/**/*.js
test/**/*.js.map

# Generated code
generated/
codegen/

# Local development notes
TODO.md
NOTES.md
.notes/

# GitHub Actions artifacts
.github/workflows/*.log

# Misc
.turbo/
.next/
dist-prod/

# Personal
GeoReporta/

# Project docs & specs (not needed in runtime)
docs/
CLAUDE.md
MEMORY.md
.claude/

# Frontend build output (regenerated on deploy)
frontend/dist/
frontend/browser/

# Build artifacts from CI
*.tgz
build-*.tar.gz
